{
  "verify": "npm test",
  "maxIterations": 8,
  "maxToolCalls": 200,
  "verifyTimeoutSec": 240,
  "staleHours": 12,
  "requireReview": true,
  "checkpointCommits": true,
  "protectedPaths": [
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "jest.config.*",
    "vitest.config.*",
    "vitest.workspace.*",
    "playwright.config.*",
    "karma.conf.*",
    ".mocharc.*",
    "pytest.ini",
    "tox.ini",
    "*.runsettings",
    "**/__snapshots__/**"
  ]
}
